# =============================================================================
# MessMind AI: Production & Deployment Environment Configuration
# =============================================================================

# Deployment Environment: 'production' or 'development'
# When 'production', default demo credentials and one-click logins are disabled.
ENVIRONMENT=production

# Enable or disable evaluation demo accounts (admin, kitchen, student)
# In production, set to 'false' to ensure only authentic accounts can sign in.
ENABLE_DEMO_CREDENTIALS=false

# SQLite Database Persistence Path
# On cloud platforms (Render, Railway, Fly.io, Docker), point to a persistent mounted volume
# e.g., /mnt/data/messmind.db
MESSMIND_DB_PATH=data/messmind.db

# Path to the Official Weekly Menu JSON
MESSMIND_MENU_PATH=data/weekly_menu.json

# Path to Synchronized CSV Archive
MESSMIND_CSV_PATH=data/mess_data.csv

# Initial Administrator Account (used only on first database initialization in production)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeThisSecurePassword!2026

# Streamlit Port & Headless Flags (configured via .streamlit/config.toml or CLI)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

